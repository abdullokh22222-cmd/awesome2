    </nav>

    <!-- contact sheet -->
    <div class="m-sheet" id="m-sheet" onclick="if(event.target===this)window.mCloseSheet&&window.mCloseSheet()">
      <div class="m-sheet-card">
        <button type="button" class="m-sheet-close" aria-label="Close" onclick="window.mCloseSheet&&window.mCloseSheet()">×</button>
        <h3>Обсудить проект</h3>
        <p class="sub">Расскажи о задаче — мы подскажем лучшее решение.</p>
        <form id="m-contact-form" novalidate>
          <input type="text" name="name" placeholder="Имя" autocomplete="name" />
          <input type="tel"  name="phone" placeholder="Telegram / WhatsApp / +998" autocomplete="tel" />
          <textarea name="project" placeholder="О проекте"></textarea>
          <button type="submit">Отправить</button>
          <p class="m-form-status"></p>
        </form>
        <div class="m-contact-links">
          <a href="https://www.instagram.com/HYPE_PROMOTION_UZ" target="_blank" rel="noreferrer">
            <span>Instagram</span><strong>HYPE_PROMOTION_UZ</strong>
          </a>
          <a href="tel:+998935064200">
            <span>Телефон</span><strong>+998 93 506 42 00</strong>
          </a>
        </div>
      </div>
