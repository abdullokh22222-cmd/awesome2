  <div class="scroll-hint" id="scrollHint" data-i18n="scrollHint">Scroll</div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script>
    const i18n = {
      en: { headerCta:"Start project",scrollHint:"Scroll",ctaStart:"Start a project",ctaWorks:"View works",ctaDiscuss:"Discuss project",statVideos:"videos created",statCompanies:"companies",statBloggers:"bloggers",s0Eyebrow:"Cinematic Video Studio",s0Title:"HYPE PRODUCTION",s0Lead:"We turn any idea into a powerful video.",s1Eyebrow:"Enter the studio",s1Title:"8 <span class='gradient'>directions.</span> One studio.",s1Lead:"Each direction has its own room. Keep scrolling.",s2Eyebrow:"Commercial Videos",s2Title:"Built for <span class='gradient'>paid media.</span>",s2Lead:"High-impact videos for ad campaigns and launches.",s3Eyebrow:"AI Generated",s3Title:"Concept worlds <span class='gradient'>by AI.</span>",s3Lead:"Concepts and visual systems powered by AI.",s4Eyebrow:"Social Media Reels",s4Title:"Built for <span class='gradient'>the thumb.</span>",s4Lead:"Vertical edits. Hook, retention, DM shares.",s5Eyebrow:"Brand Promo Films",s5Title:"Premium <span class='gradient'>storytelling.</span>",s5Lead:"Cinematic shooting, sound design, color.",s6Eyebrow:"Motion Design",s6Title:"Kinetic <span class='gradient'>typography.</span>",s6Lead:"Titles, transitions, UI motion, kinetic typography.",s7Eyebrow:"Product Ads",s7Title:"Clean. Focused. <span class='gradient'>Converts.</span>",s7Lead:"Product ads for funnels and launches.",s8Eyebrow:"New service",s8Title:"We build <span class='gradient'>sites too.</span>",s8Lead:"From prompt to launched site — in days.",s9Eyebrow:"Landing pages",s9Title:"One page. <span class='gradient'>One goal.</span>",s9Lead:"3–5 sections, form, mobile — in days.",s9Price:"<strong style='color:var(--blue)'>from 4 000 000 UZS</strong> · 5–7 days",s10Eyebrow:"Brand sites",s10Title:"Full <span class='gradient'>brand experience.</span>",s10Lead:"Multi-page site with animations and blog.",s10Price:"<strong style='color:var(--violet)'>from 9 000 000 UZS</strong> · 2–3 weeks",s11Eyebrow:"Cinematic sites",s11Title:"Like the one <span class='gradient'>you're in.</span>",s11Lead:"3D scenes, scroll-driven animations, custom graphics.",s11Price:"<strong style='color:var(--gold)'>from 18 000 000 UZS</strong> · 4–6 weeks",s12Eyebrow:"Video packages",s12Title:"Start simple. <span class='gradient'>Scale when it works.</span>",priceStartLabel:"START",priceStartTitle:"AI Reel",priceStartPrice:"from 1 000 000 UZS",priceGrowthLabel:"GROWTH",priceGrowthTitle:"Reels Pack",priceGrowthPrice:"from 3 000 000 UZS",priceHypeLabel:"HYPE",priceHypeTitle:"AI Promo",priceHypePrice:"from 7 000 000 UZS",s13Eyebrow:"Selected work",s13Title:"AI, reels <span class='gradient'>and cinematic.</span>",s13Lead:"Camera drifts past a wall of screens.",s14Eyebrow:"How we work",s14Title:"From idea <span class='gradient'>to launch.</span>",s14Lead:"5 steps from first meeting to publication.",s15Eyebrow:"Studio",s15Title:"HYPE PRODUCTION creates <span class='gradient'>AI videos, reels and premium content</span> for brands.",s16Eyebrow:"Request",s16Title:"Ready to <span class='gradient'>launch?</span>",s16Lead:"Tell us your idea. We'll respond within 24h.",instagramLabel:"Instagram",phoneLabel:"Phone",formName:"Name",formNamePlaceholder:"Your name",formPhone:"Phone",formPhonePlaceholder:"+998",formProject:"Project",formProjectPlaceholder:"What do you want to create?",formSubmit:"Send request",formSuccess:"Thanks — we'll be in touch within 24h.",formError:"Please fill in name and phone." },
      ru: { headerCta:"Начать проект",scrollHint:"Скроль",ctaStart:"Начать проект",ctaWorks:"Смотреть работы",ctaDiscuss:"Обсудить проект",statVideos:"созданных видео",statCompanies:"компаний",statBloggers:"блогеров",s0Eyebrow:"Cinematic-студия видеопродакшна",s0Title:"HYPE PRODUCTION",s0Lead:"Воплощаем любые идеи в кадре.",s1Eyebrow:"Войди в студию",s1Title:"8 <span class='gradient'>направлений.</span> Одна студия.",s1Lead:"Каждое направление — собственная сцена. Камера проведёт через все.",s2Eyebrow:"Рекламные видео",s2Title:"Сделано для <span class='gradient'>рекламы.</span>",s2Lead:"Видео высокого импакта для рекламных кампаний.",s3Eyebrow:"AI-видео",s3Title:"Концепт-миры <span class='gradient'>с помощью AI.</span>",s3Lead:"Концепты и визуальные системы на основе AI.",s4Eyebrow:"Reels для соцсетей",s4Title:"Сделано <span class='gradient'>для большого пальца.</span>",s4Lead:"Вертикальные монтажи. Хук, удержание, пересылки.",s5Eyebrow:"Brand-фильмы",s5Title:"Премиальный <span class='gradient'>сторителлинг.</span>",s5Lead:"Cinematic-съёмка, саунд-дизайн, цветокоррекция.",s6Eyebrow:"Motion-дизайн",s6Title:"Кинетическая <span class='gradient'>типографика.</span>",s6Lead:"Титры, переходы, UI-motion, типографика в движении.",s7Eyebrow:"Product-реклама",s7Title:"Чисто. Сфокусированно. <span class='gradient'>Продаёт.</span>",s7Lead:"Продуктовая реклама для воронок и запусков.",s8Eyebrow:"Новая услуга",s8Title:"Мы делаем <span class='gradient'>и сайты.</span>",s8Lead:"От промпта до запущенного сайта — за дни.",s9Eyebrow:"Лендинги",s9Title:"Одна страница. <span class='gradient'>Одна цель.</span>",s9Lead:"3–5 секций, форма, мобильная версия — за дни.",s9Price:"<strong style='color:var(--blue)'>от 4 000 000 UZS</strong> · 5–7 дней",s10Eyebrow:"Brand-сайты",s10Title:"Полный <span class='gradient'>brand-опыт.</span>",s10Lead:"Многостраничный сайт со скролл-анимациями и блогом.",s10Price:"<strong style='color:var(--violet)'>от 9 000 000 UZS</strong> · 2–3 недели",s11Eyebrow:"Cinematic-сайты",s11Title:"Как тот, <span class='gradient'>в котором ты сейчас.</span>",s11Lead:"3D-сцены, scroll-driven анимации, кастомная графика.",s11Price:"<strong style='color:var(--gold)'>от 18 000 000 UZS</strong> · 4–6 недель",s12Eyebrow:"Видео-пакеты",s12Title:"Начни просто. <span class='gradient'>Масштабируй, когда контент работает.</span>",priceStartLabel:"START",priceStartTitle:"AI Reel",priceStartPrice:"от 1 000 000 UZS",priceGrowthLabel:"GROWTH",priceGrowthTitle:"Reels Pack",priceGrowthPrice:"от 3 000 000 UZS",priceHypeLabel:"HYPE",priceHypeTitle:"AI Promo",priceHypePrice:"от 7 000 000 UZS",s13Eyebrow:"Избранные работы",s13Title:"AI, reels <span class='gradient'>и cinematic.</span>",s13Lead:"Камера медленно проезжает мимо стены экранов.",s14Eyebrow:"Как мы работаем",s14Title:"От идеи <span class='gradient'>до запуска.</span>",s14Lead:"5 этапов от первой встречи до публикации.",s15Eyebrow:"Студия",s15Title:"HYPE PRODUCTION делает <span class='gradient'>AI-видео, reels и премиум-контент</span> для брендов.",s16Eyebrow:"Заявка",s16Title:"Готовы <span class='gradient'>запускать?</span>",s16Lead:"Расскажи идею. Ответим в течение 24 часов.",instagramLabel:"Instagram",phoneLabel:"Телефон",formName:"Имя",formNamePlaceholder:"Ваше имя",formPhone:"Телефон",formPhonePlaceholder:"+998",formProject:"Проект",formProjectPlaceholder:"Что хотите создать?",formSubmit:"Отправить заявку",formSuccess:"Спасибо — ответим в течение 24 часов.",formError:"Заполните имя и телефон." },
      uz: { headerCta:"Loyiha boshlash",scrollHint:"Pastga",ctaStart:"Loyiha boshlash",ctaWorks:"Ishlarni ko'rish",ctaDiscuss:"Muhokama",statVideos:"yaratilgan video",statCompanies:"kompaniya",statBloggers:"bloger",s0Eyebrow:"Cinematic video studio",s0Title:"HYPE PRODUCTION",s0Lead:"Har qanday g'oyani videoga aylantiramiz.",s1Eyebrow:"Studiyaga kirish",s1Title:"8 <span class='gradient'>yo'nalish.</span> Bir studiya.",s1Lead:"Har biri o'z sahnasi. Kamera olib o'tadi.",s2Eyebrow:"Reklama videolari",s2Title:"Reklama uchun <span class='gradient'>yaratilgan.</span>",s2Lead:"Yuqori ta'sirli reklama videolari.",s3Eyebrow:"AI-videolar",s3Title:"AI yordamida <span class='gradient'>konsept dunyolar.</span>",s3Lead:"AI asosidagi konsept va vizual tizimlar.",s4Eyebrow:"Reels",s4Title:"Bosh barmoq uchun <span class='gradient'>yaratilgan.</span>",s4Lead:"Vertikal montajlar.",s5Eyebrow:"Brend-filmlar",s5Title:"Premium <span class='gradient'>storytelling.</span>",s5Lead:"Cinematic suratga olish, ovoz dizayn.",s6Eyebrow:"Motion-dizayn",s6Title:"Kinetik <span class='gradient'>tipografika.</span>",s6Lead:"Titrlar, o'tishlar, UI-motion.",s7Eyebrow:"Mahsulot reklamasi",s7Title:"Toza. Aniq. <span class='gradient'>Sotadi.</span>",s7Lead:"Mahsulotga yo'naltirilgan reklama.",s8Eyebrow:"Yangi xizmat",s8Title:"Biz <span class='gradient'>saytlar ham qilamiz.</span>",s8Lead:"Promptdan ishga tushgan saytgacha — kunlarda.",s9Eyebrow:"Lending",s9Title:"Bir sahifa. <span class='gradient'>Bir maqsad.</span>",s9Lead:"Bir maqsad uchun lending. Kunlarda.",s9Price:"<strong style='color:var(--blue)'>4 000 000 UZSdan</strong> · 5–7 kun",s10Eyebrow:"Brend saytlar",s10Title:"To'liq <span class='gradient'>brend tajriba.</span>",s10Lead:"Ko'p sahifali sayt.",s10Price:"<strong style='color:var(--violet)'>9 000 000 UZSdan</strong> · 2–3 hafta",s11Eyebrow:"Cinematic saytlar",s11Title:"Siz <span class='gradient'>turgan saytga o'xshash.</span>",s11Lead:"3D sahnalar va maxsus grafika.",s11Price:"<strong style='color:var(--gold)'>18 000 000 UZSdan</strong> · 4–6 hafta",s12Eyebrow:"Video paketlar",s12Title:"Sodda boshlang. <span class='gradient'>Ishlasa — kengaytiring.</span>",priceStartLabel:"START",priceStartTitle:"AI Reel",priceStartPrice:"1 000 000 UZSdan",priceGrowthLabel:"GROWTH",priceGrowthTitle:"Reels Pack",priceGrowthPrice:"3 000 000 UZSdan",priceHypeLabel:"HYPE",priceHypeTitle:"AI Promo",priceHypePrice:"7 000 000 UZSdan",s13Eyebrow:"Tanlangan ishlar",s13Title:"AI, reels <span class='gradient'>va cinematic.</span>",s13Lead:"Kamera ekranlar devori bo'ylab harakatlanadi.",s14Eyebrow:"Qanday ishlaymiz",s14Title:"G'oyadan <span class='gradient'>ishga tushirishgacha.</span>",s14Lead:"5 bosqich.",s15Eyebrow:"Studiya",s15Title:"HYPE PRODUCTION <span class='gradient'>AI-video, reels va premium kontent</span> yaratadi.",s16Eyebrow:"Buyurtma",s16Title:"Boshlashga <span class='gradient'>tayyormisiz?</span>",s16Lead:"G'oyangizni ayting. 24 soat ichida javob beramiz.",instagramLabel:"Instagram",phoneLabel:"Telefon",formName:"Ism",formNamePlaceholder:"Sizning ismingiz",formPhone:"Telefon",formPhonePlaceholder:"+998",formProject:"Loyiha",formProjectPlaceholder:"Nimani yaratmoqchisiz?",formSubmit:"Yuborish",formSuccess:"Rahmat — 24 soat ichida javob beramiz.",formError:"Ism va telefonni to'ldiring." }
    };
    let curLang = 'ru';

    /* ============================================================
       BACKEND CONFIG — Google Apps Script Web App URL.
       After deploying apps-script.gs (Extensions → Apps Script → Deploy →
       Web app, "Anyone"), paste the resulting URL here.
       Until then, the form just shows a success message without sending.
       ============================================================ */
    const APPS_SCRIPT_URL = ''; // ← вставить сюда URL после деплоя Apps Script

    function currentMode(){
      const html = document.documentElement;
      if(html.classList.contains('mode-landing'))    return 'landing';
      if(html.classList.contains('mode-multipage'))  return 'multipage';
      if(html.classList.contains('mode-cinematic'))  return 'cinematic';
      return 'unknown';
    }

    function submitLead(payload){
      // No URL configured yet — pretend success so the user sees a positive UX.
      if(!APPS_SCRIPT_URL){
        return Promise.resolve({ ok: true, offline: true });
      }
      return fetch(APPS_SCRIPT_URL, {
        method: 'POST',
        // text/plain avoids the CORS preflight that blocks application/json on Apps Script.
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify(payload),
        redirect: 'follow',
      })
      .then(r => r.json())
      .catch(err => ({ ok: false, error: String(err && err.message || err) }));
    }

    function applyLang(L){if(!i18n[L])return;curLang=L;document.documentElement.lang=L;const t=i18n[L];document.querySelectorAll('[data-i18n]').forEach(e=>{const k=e.getAttribute('data-i18n');if(t[k]!==undefined)e.innerHTML=t[k]});document.querySelectorAll('[data-i18n-placeholder]').forEach(e=>{const k=e.getAttribute('data-i18n-placeholder');if(t[k]!==undefined)e.setAttribute('placeholder',t[k])});document.querySelectorAll('.lang-switcher button').forEach(b=>b.classList.toggle('active',b.dataset.lang===L))}
    document.querySelectorAll('.lang-switcher button').forEach(b=>b.addEventListener('click',()=>applyLang(b.dataset.lang)));
    applyLang('ru');

    const canvas = document.getElementById('three-canvas');
    // Detect device tier: mobile / low-end gets a lighter setup
    const isMobile = window.matchMedia('(max-width: 720px)').matches || window.matchMedia('(pointer: coarse)').matches;
    const isTablet = !isMobile && window.matchMedia('(max-width: 960px)').matches;
    const lowPower = isMobile && (navigator.hardwareConcurrency || 4) <= 4;
    const renderer = new THREE.WebGLRenderer({ canvas, antialias: !lowPower, alpha: true, powerPreference: 'high-performance' });
    const dprCap = isMobile ? 1.5 : 2;
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, dprCap));
    renderer.outputEncoding = THREE.sRGBEncoding;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.05;
    const maxAniso = renderer.capabilities.getMaxAnisotropy ? renderer.capabilities.getMaxAnisotropy() : 1;
    const scene = new THREE.Scene();
    scene.fog = new THREE.Fog(0x02040a, 8, 60);
    // Wider FOV on mobile so portrait viewports still see the whole 3D scene
    const baseFov = isMobile ? 60 : (isTablet ? 50 : 40);
    const camera = new THREE.PerspectiveCamera(baseFov, 1, 0.1, 600);
    camera.position.set(0, 0.8, 9);
    // Aspect-based zoom-out factor: portrait screens push camera back further
    let aspectFactor = 1;
    function recalcAspect(){
      const w = canvas.clientWidth, h = canvas.clientHeight;
      const ar = w/h;
      // Reference is 16:9 (1.78). Narrower aspects (mobile portrait ~0.46) need more distance.
      aspectFactor = clamp(1.78 / Math.max(ar, 0.35), 1, 2.4);
    }
    function resize(){
      const w=canvas.clientWidth,h=canvas.clientHeight;
      renderer.setSize(w,h,false);
      camera.aspect=w/h;
      camera.updateProjectionMatrix();
      recalcAspect();
    }
    window.addEventListener('resize',resize);
    window.addEventListener('orientationchange', () => setTimeout(resize, 200));
    /* ============================================================
       SIMPLIFIED CINEMATIC CORRIDOR
       One long premium corridor. No sci-fi clutter.
       Per-scene mood comes from lighting + accent color,
       not from new geometry.
       ============================================================ */

    // Tighter, deeper fog → atmosphere + depth
    scene.fog = new THREE.Fog(0x02040a, 6, 36);

    // Base illumination (very soft — corridor reads as "dark premium")
    const ambientLight = new THREE.AmbientLight(0xffffff, 0.18);
    scene.add(ambientLight);

    // Reactive lights — these follow the camera and shift color per scene.
    const keyLight  = new THREE.PointLight(0xffffff, 0.45, 28, 1.6);
    const fillLight = new THREE.PointLight(0x6ee7ff, 0.60, 32, 1.4);
    const rimLight  = new THREE.PointLight(0xffffff, 0.30, 22, 1.8);
    scene.add(keyLight, fillLight, rimLight);

    // Far-end beacon — the "light at the end of the corridor"
    const endBeacon = new THREE.PointLight(0xffffff, 1.0, 140, 1.6);
    endBeacon.position.set(0, 1.4, -440);
    scene.add(endBeacon);

    // -------- Corridor dimensions --------
    const CORRIDOR_W = 7.6;     // wall-to-wall width
    const CORRIDOR_H = 5.0;     // floor-to-ceiling
    const CORRIDOR_START = 30;
    const CORRIDOR_END   = -460;
    const CORRIDOR_LEN   = CORRIDOR_START - CORRIDOR_END;
    const CORRIDOR_MID_Z = (CORRIDOR_START + CORRIDOR_END) / 2;

    // -------- Materials (glossy black, very minimal) --------
    const wallMat = new THREE.MeshStandardMaterial({
      color: 0x0a0d14, metalness: 0.92, roughness: 0.28
    });
    const floorMat = new THREE.MeshStandardMaterial({
      color: 0x05070c, metalness: 0.95, roughness: 0.20
    });
    const ceilMat = new THREE.MeshStandardMaterial({
      color: 0x06080e, metalness: 0.55, roughness: 0.55
    });

    // -------- Floor / Ceiling / Walls --------
    const floor = new THREE.Mesh(
      new THREE.PlaneGeometry(CORRIDOR_W * 1.4, CORRIDOR_LEN + 60),
      floorMat
    );
    floor.rotation.x = -Math.PI / 2;
    floor.position.set(0, -0.55, CORRIDOR_MID_Z);
    scene.add(floor);

    const ceiling = new THREE.Mesh(
      new THREE.PlaneGeometry(CORRIDOR_W * 1.4, CORRIDOR_LEN + 60),
      ceilMat
    );
    ceiling.rotation.x = Math.PI / 2;
    ceiling.position.set(0, CORRIDOR_H - 0.55, CORRIDOR_MID_Z);
    scene.add(ceiling);

    const wallL = new THREE.Mesh(
      new THREE.PlaneGeometry(CORRIDOR_LEN + 60, CORRIDOR_H),
      wallMat
    );
    wallL.position.set(-CORRIDOR_W / 2, (CORRIDOR_H - 1.1) / 2, CORRIDOR_MID_Z);
    wallL.rotation.y = Math.PI / 2;
    scene.add(wallL);

    const wallR = new THREE.Mesh(
      new THREE.PlaneGeometry(CORRIDOR_LEN + 60, CORRIDOR_H),
      wallMat
    );
    wallR.position.set(CORRIDOR_W / 2, (CORRIDOR_H - 1.1) / 2, CORRIDOR_MID_Z);
    wallR.rotation.y = -Math.PI / 2;
    scene.add(wallR);

    // -------- Repeating architecture: ceiling light slits, floor lines,
    //         recessed wall light bars. Modular every REPEAT units. --------
    const REPEAT = 6;
    const accentMats = [];   // every material that tints with the active scene
    for(let z = CORRIDOR_START; z >= CORRIDOR_END - REPEAT; z -= REPEAT){
      // Ceiling overhead light slit (always cool white, subtle)
      const cs = new THREE.Mesh(
        new THREE.PlaneGeometry(0.45, REPEAT * 0.62),
        new THREE.MeshBasicMaterial({ color: 0xffffff, transparent: true, opacity: 0.42 })
      );
      cs.rotation.x = Math.PI / 2;
      cs.position.set(0, CORRIDOR_H - 0.56, z - REPEAT / 2);
      scene.add(cs);

      // Floor accent lines (recolor per scene)
      const flMatL = new THREE.MeshBasicMaterial({ color: 0xffffff, transparent: true, opacity: 0.36 });
      const flMatR = new THREE.MeshBasicMaterial({ color: 0xffffff, transparent: true, opacity: 0.36 });
      const flL = new THREE.Mesh(new THREE.PlaneGeometry(0.07, REPEAT * 0.85), flMatL);
      const flR = new THREE.Mesh(new THREE.PlaneGeometry(0.07, REPEAT * 0.85), flMatR);
      flL.rotation.x = -Math.PI / 2; flR.rotation.x = -Math.PI / 2;
      flL.position.set(-CORRIDOR_W * 0.38, -0.535, z - REPEAT / 2);
      flR.position.set( CORRIDOR_W * 0.38, -0.535, z - REPEAT / 2);
      scene.add(flL); scene.add(flR);
      accentMats.push(flMatL, flMatR);

      // Wall recessed light bars (recolor per scene)
      const wbMatL = new THREE.MeshBasicMaterial({ color: 0xffffff, transparent: true, opacity: 0.55 });
      const wbMatR = new THREE.MeshBasicMaterial({ color: 0xffffff, transparent: true, opacity: 0.55 });
      const wbL = new THREE.Mesh(new THREE.PlaneGeometry(0.05, 1.5), wbMatL);
      const wbR = new THREE.Mesh(new THREE.PlaneGeometry(0.05, 1.5), wbMatR);
      wbL.position.set(-CORRIDOR_W / 2 + 0.03, 1.15, z - REPEAT / 2);
      wbR.position.set( CORRIDOR_W / 2 - 0.03, 1.15, z - REPEAT / 2);
      wbL.rotation.y =  Math.PI / 2;
      wbR.rotation.y = -Math.PI / 2;
      scene.add(wbL); scene.add(wbR);
      accentMats.push(wbMatL, wbMatR);
    }

    // -------- Subtle volumetric "shafts" from the ceiling (atmosphere only) --------
    const beamGeo = new THREE.ConeGeometry(0.55, 4.0, 22, 1, true);
    const beams = [];
    for(let z = CORRIDOR_START - 9; z >= CORRIDOR_END + 8; z -= 22){
      const beam = new THREE.Mesh(beamGeo, new THREE.MeshBasicMaterial({
        color: 0xffffff, transparent: true, opacity: 0.06,
        blending: THREE.AdditiveBlending, depthWrite: false, side: THREE.DoubleSide
      }));
      beam.position.set(0, CORRIDOR_H - 2.4, z);
      beam.rotation.x = Math.PI;
      scene.add(beam);
      beams.push(beam);
    }

    // -------- Far-end "exit" plane + halo (blooms on final scene) --------
    const endPlane = new THREE.Mesh(
      new THREE.PlaneGeometry(2.2, 3.2),
      new THREE.MeshBasicMaterial({ color: 0xffffff, transparent: true, opacity: 0 })
    );
    endPlane.position.set(0, 1.35, CORRIDOR_END + 18);
    scene.add(endPlane);
    const endHalo = new THREE.Mesh(
      new THREE.RingGeometry(2.0, 5.6, 48),
      new THREE.MeshBasicMaterial({
        color: 0xffffff, transparent: true, opacity: 0,
        side: THREE.DoubleSide, blending: THREE.AdditiveBlending, depthWrite: false
      })
    );
    endHalo.position.set(0, 1.35, CORRIDOR_END + 18.05);
    scene.add(endHalo);

    const M = THREE;
    const lerp=(a,b,t)=>a+(b-a)*t;
    const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
    const smoothstep=(e0,e1,x)=>{const t=clamp((x-e0)/(e1-e0),0,1);return t*t*(3-2*t)};
    const easeInOut=t=>t<0.5?2*t*t:1-Math.pow(-2*t+2,2)/2;
    const wireMat=(c,o=0.7)=>new M.LineBasicMaterial({color:c,transparent:true,opacity:o});
    const addEdges=(m,c,o)=>{const e=new M.LineSegments(new M.EdgesGeometry(m.geometry),wireMat(c,o));m.add(e);return e};
    let buildingVideoIds = null;
    const videoTextures = new Map();
    const missingVideoTextures = new Map();
    function prepareVideo(v){
      if(!v) return null;
      v.autoplay = false;
      v.muted = true;
      v.loop = true;
      v.playsInline = true;
      v.preload = 'metadata';
      if(v.readyState === 0) v.load();
      return v;
    }
    function primeVideo(v){
      if(!v) return;
      v.muted = true;
      v.loop = true;
      v.playsInline = true;
      v.preload = 'auto';
      const warm = () => {
        if(Number.isFinite(v.duration) && v.duration > 0 && v.currentTime < 0.05){
          try { v.currentTime = Math.min(0.6, Math.max(0.12, v.duration * 0.04)); } catch(e) {}
        }
        const p = v.play();
        if(p && p.catch) p.catch(()=>{});
      };
      if(v.readyState >= 1) warm();
      else v.addEventListener('loadedmetadata', warm, {once:true});
      v.load();
      const p = v.play();
      if(p && p.catch) p.catch(()=>{});
    }
    function vidTex(id){
      if(buildingVideoIds) buildingVideoIds.add(id);
      if(videoTextures.has(id)) return videoTextures.get(id);
      const v=document.getElementById(id);
      if(!v){
        if(missingVideoTextures.has(id)) return missingVideoTextures.get(id);
        const c=document.createElement('canvas'); c.width=32; c.height=32;
        const x=c.getContext('2d'); x.fillStyle='#02040a'; x.fillRect(0,0,32,32);
        const t=new M.CanvasTexture(c); t.minFilter=M.LinearFilter; t.magFilter=M.LinearFilter;
        missingVideoTextures.set(id,t); return t;
      }
      prepareVideo(v);
      const t=new M.VideoTexture(v);
      t.minFilter=M.LinearFilter;
      t.magFilter=M.LinearFilter;
      t.generateMipmaps=false;
      t.anisotropy=maxAniso;
      if('encoding' in t) t.encoding=M.sRGBEncoding;
      t.needsUpdate=true;
      videoTextures.set(id,t);
      return t;
    }
    function emptyFrameMat(){
      return new M.MeshBasicMaterial({color:0x02040a,transparent:true,opacity:0.72,side:M.DoubleSide});
    }
    function videoFrameMat(id){
      return id ? new M.MeshBasicMaterial({map:vidTex(id),side:M.DoubleSide}) : emptyFrameMat();
    }
    function textTex(text,o={}){const w=o.w||1024,h=o.h||256;const c=document.createElement('canvas');c.width=w;c.height=h;const x=c.getContext('2d');x.fillStyle=o.bg||'rgba(0,0,0,0)';x.fillRect(0,0,w,h);x.fillStyle=o.color||'#f8fbff';x.font=`${o.weight||900} ${o.size||140}px Inter, "Arial Black", sans-serif`;x.textAlign='center';x.textBaseline='middle';x.fillText(text,w/2,h/2);const t=new M.CanvasTexture(c);t.minFilter=M.LinearFilter;return t}

    /* ============================================================
       Scene stubs.
       Same z positions + labels as before, so existing camera / video
       sync / scene-counter logic keeps working. Each scene only carries
       an accent color + intensity that drives corridor lighting.
       ============================================================ */
    const laptopMeta = null;
    const lobbyMeta  = null;

    const SCENE_ACCENTS = {
      LAPTOP:           { color: 0xeaf2ff, intensity: 0.55 },   // entering — cool white
      LOBBY:            { color: 0xdfeaff, intensity: 0.60 },   // navigation rings, soft white
      COMMERCIAL:       { color: 0xffe6c0, intensity: 0.65 },   // industrial warm LED
      AI_VIDEO:         { color: 0x6ec8ff, intensity: 0.85 },   // AI blue
      REELS:            { color: 0xc89aff, intensity: 0.80 },   // vertical purple
      BRAND_FILMS:      { color: 0xffb070, intensity: 0.75 },   // film studio warm
      MOTION:           { color: 0xa6e9ff, intensity: 0.60 },   // glass / post
      PRODUCT_ADS:      { color: 0xf0f4ff, intensity: 0.65 },   // clean white
      AI_SITES:         { color: 0x86c8ff, intensity: 0.75 },   // digital interface
      LANDING:          { color: 0x9ee9d6, intensity: 0.65 },   // teal
      BRAND_SITES:      { color: 0xa28cff, intensity: 0.70 },   // brand violet
      CINEMATIC_SITES:  { color: 0xffcd6e, intensity: 0.85 },   // gold cinematic
      PRICING:          { color: 0xf8f5ec, intensity: 0.65 },   // premium ivory
      PORTFOLIO:        { color: 0x6ec8ff, intensity: 0.70 },   // gallery blue
      PROCESS:          { color: 0xffcd6e, intensity: 0.65 },   // warm storyboard
      ABOUT:            { color: 0xeaf3ff, intensity: 0.70 },   // calm white
      CONTACT:          { color: 0xffffff, intensity: 1.20 },   // bright end of corridor
    };

    const SCENE_DEFS = [
      { z:    0, label: 'LAPTOP'          },
      { z:  -25, label: 'LOBBY'           },
      { z:  -50, label: 'COMMERCIAL'      },
      { z:  -75, label: 'AI_VIDEO'        },
      { z: -100, label: 'REELS'           },
      { z: -125, label: 'BRAND_FILMS'     },
      { z: -150, label: 'MOTION'          },
      { z: -175, label: 'PRODUCT_ADS'     },
      { z: -200, label: 'AI_SITES'        },
      { z: -225, label: 'LANDING'         },
      { z: -250, label: 'BRAND_SITES'     },
      { z: -275, label: 'CINEMATIC_SITES' },
      { z: -300, label: 'PRICING'         },
      { z: -325, label: 'PORTFOLIO'       },
      { z: -350, label: 'PROCESS'         },
      { z: -375, label: 'ABOUT'           },
      { z: -400, label: 'CONTACT'         },
    ];
    const scenes = SCENE_DEFS.map(d => ({
      z: d.z,
      label: d.label,
      group: new THREE.Group(),
      videoIds: [],
      accent: SCENE_ACCENTS[d.label] || { color: 0xffffff, intensity: 0.6 }
    }));

    // Tinting helper — re-colors strips/bars and the reactive lights.
    const _accentTmpA = new THREE.Color();
    const _accentTmpB = new THREE.Color();
    function applyAccent(i, t){
      const a = scenes[i].accent;
      const b = scenes[Math.min(i + 1, scenes.length - 1)].accent;
      _accentTmpA.setHex(a.color);
      _accentTmpB.setHex(b.color);
      _accentTmpA.lerp(_accentTmpB, t);
      const intensity = a.intensity + (b.intensity - a.intensity) * t;

      // Floor lines + wall light bars
      for(let k = 0; k < accentMats.length; k++){
        accentMats[k].color.copy(_accentTmpA);
        accentMats[k].opacity = 0.30 + intensity * 0.30;
      }
      // Reactive lights take on the scene's mood
      fillLight.color.copy(_accentTmpA);
      fillLight.intensity = 0.55 + intensity * 0.70;
      rimLight.color.copy(_accentTmpA);
      rimLight.intensity  = 0.20 + intensity * 0.40;
      keyLight.intensity  = 0.30 + intensity * 0.20;

      // Volumetric beams
      for(const beam of beams){
        beam.material.color.copy(_accentTmpA);
        beam.material.opacity = 0.05 + intensity * 0.04;
      }

      // End-of-corridor exit only blooms in the final stretch
      const finalT = (i + t) / (scenes.length - 1);
      const closeness = Math.max(0, (finalT - 0.78) / 0.22);
      endPlane.material.opacity = closeness * 0.95;
      endHalo.material.opacity  = closeness * 0.55;
      endBeacon.intensity       = 1.0 + closeness * 7.5;
    }

    // (legacy per-scene sci-fi builders removed — corridor + accent lighting handle all moods)

    const sceneNames = ['00 LAPTOP','01 LOBBY','02 COMMERCIAL','03 AI VIDEO','04 REELS','05 BRAND FILMS','06 MOTION','07 PRODUCT ADS','08 AI SITES','08a LANDING','08b BRAND SITES','08c CINEMATIC','09 PRICING','10 PORTFOLIO','11 PROCESS','12 STUDIO','13 CONTACT'];
    document.getElementById('sceneTotal').textContent = String(sceneNames.length);

    const stages = document.querySelectorAll('.stage');
    const progressBar = document.querySelector('.scroll-progress');
    const sceneNow = document.getElementById('sceneNow');
    const sceneLabel = document.getElementById('sceneLabel');
    const scrollHint = document.getElementById('scrollHint');
    const portalFlash = document.getElementById('portalFlash');
    let globalProgress = 0;
    function onScroll(){const total=document.documentElement.scrollHeight-window.innerHeight;globalProgress=total>0?clamp(window.scrollY/total,0,1):0;progressBar.style.width=(globalProgress*100)+'%';scrollHint.classList.toggle('hidden',window.scrollY>window.innerHeight*0.3)}
    window.addEventListener('scroll',onScroll,{passive:true}); onScroll();

    /* Multipage navigation wiring — add id=stage-N to every section
       and highlight the matching nav link on scroll. */
    stages.forEach(s => {
      const i = s.getAttribute('data-stage');
      if(i !== null && !s.id) s.id = 'stage-' + i;
    });
    const mpNavLinks = Array.from(document.querySelectorAll('.mp-nav a'));
    function setActiveNavLink(stageIdx){
      // Map each stage to the nearest nav anchor (largest stage <= idx wins).
      const targets = [
        { idx: 0,  sel: '[href="#stage-0"]'  },
        { idx: 1,  sel: '[href="#stage-1"]'  },
        { idx: 13, sel: '[href="#works"]'    },
        { idx: 12, sel: '[href="#stage-12"]' },
        { idx: 14, sel: '[href="#stage-14"]' },
        { idx: 16, sel: '[href="#contact"]'  },
      ].sort((a,b)=>a.idx-b.idx);
      let activeSel = targets[0].sel;
      for(const t of targets){ if(t.idx <= stageIdx) activeSel = t.sel; }
      mpNavLinks.forEach(a => a.classList.toggle('active', a.matches(activeSel)));
    }

    const sObs = new IntersectionObserver(es => {
      es.forEach(e => {
        e.target.classList.toggle('in', e.isIntersecting);
        if(e.isIntersecting){
          const idx = parseInt(e.target.getAttribute('data-stage'), 10);
          sceneNow.textContent = String(idx).padStart(2, '0');
          sceneLabel.textContent = sceneNames[idx].split(' ').slice(1).join(' ') || sceneNames[idx];
          setActiveNavLink(idx);
        }
      });
    }, { threshold: 0.5 });
    stages.forEach(s => sObs.observe(s));

    document.querySelectorAll('a[href^="#"]').forEach(a => a.addEventListener('click', e => {
      const id = a.getAttribute('href').slice(1);
      if(!id) return;
      const el = document.getElementById(id);
      if(el){ e.preventDefault(); el.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
    }));

    const form = document.getElementById('contactForm');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const st = form.querySelector('.form-status');
      const d  = new FormData(form);
      const n  = (d.get('name')    || '').trim();
      const p  = (d.get('phone')   || '').trim();
      const pr = (d.get('project') || '').trim();
      if(!n || !p){ st.textContent = i18n[curLang].formError; st.style.color = '#ff8c8c'; return; }
      st.textContent = '…'; st.style.color = '#9aa8ba';
      const result = await submitLead({
        name: n, phone: p, project: pr,
        lang: curLang, mode: currentMode(), source: 'site-desktop'
      });
      if(result && result.ok){
        st.textContent = i18n[curLang].formSuccess; st.style.color = '#6ee7ff';
        form.reset();
      } else {
        st.textContent = i18n[curLang].formError; st.style.color = '#ff8c8c';
      }
    });

    let activeSceneVideoIndex = -1;
    function syncSceneVideos(activeIndex){
      const keep = new Set();
      for(let offset=-1; offset<=1; offset++){
        const s = scenes[activeIndex + offset];
        if(s && s.videoIds) s.videoIds.forEach(id=>keep.add(id));
      }
      document.querySelectorAll('video').forEach(v=>{
        if(keep.has(v.id)){
          primeVideo(v);
        } else if(!v.paused) {
          v.pause();
        }
      });
    }

    function updateCamera(p){
      const n = scenes.length;
      const idx = p * (n - 1);
      const i = Math.min(Math.floor(idx), n - 2);
      const t = idx - i;
      if(i !== activeSceneVideoIndex){
        activeSceneVideoIndex = i;
        syncSceneVideos(i);
      }
      const easedT = easeInOut(t);
      const a = scenes[i].z, b = scenes[i+1].z;
      const sceneZ = lerp(a, b, easedT);

      // ---- Cinematic fly-through camera ----
      // Stay on the corridor's centerline. Glide forward. Tiny breathing motion.
      const tNow = performance.now() * 0.001;
      const bobY = Math.sin(tNow * 0.42) * 0.035;          // gentle vertical breathing
      const bobX = Math.sin(tNow * 0.27) * 0.045;          // subtle lateral drift
      const camHeight = 1.05;
      const camDist   = 6.2;                                // distance behind sceneZ marker
      const looksAhead = 14.0;                              // pulls the eye forward

      // Narrow viewports pull the camera back a touch so the corridor reads with depth.
      const distMul = aspectFactor > 1.05 ? (1 + (aspectFactor - 1) * 0.45) : 1;

      camera.position.set(bobX, camHeight + bobY, sceneZ + camDist * distMul);
      camera.lookAt(0, camHeight - 0.08, sceneZ - looksAhead);

      // Keep FOV steady — no zoom-pop on scene change.
      camera.fov += (baseFov - camera.fov) * 0.08;
      camera.updateProjectionMatrix();

      // Re-tint corridor accents for the current scene.
      applyAccent(i, easedT);

      // No portal flash — corridor is one continuous space.
      if(portalFlash) portalFlash.style.opacity = '0';
    }

    let t0 = performance.now();
    let isVisible = !document.hidden;
    document.addEventListener('visibilitychange', () => {
      isVisible = !document.hidden;
      if(!isVisible){
        document.querySelectorAll('video').forEach(v=>{ if(!v.paused) v.pause(); });
      } else if(activeSceneVideoIndex >= 0) {
        syncSceneVideos(activeSceneVideoIndex);
      }
    });
    function tick(){
      requestAnimationFrame(tick);
      if(!isVisible) return; // pause render when tab is hidden — saves battery on mobile
      updateCamera(globalProgress);

      // Keep the reactive lights riding with the camera so corridor accents
      // illuminate the current section rather than a fixed origin point.
      const camZ = camera.position.z;
      keyLight.position.set(0,         CORRIDOR_H - 0.7, camZ - 5);
      fillLight.position.set(0,        1.4,              camZ - 9);
      rimLight.position.set(0,         0.6,              camZ + 2);

      renderer.render(scene, camera);
    }

    let renderStarted = false;
    function start(){
      if(renderStarted) return;
      renderStarted = true;
      resize();
      recalcAspect();
      tick();
    }
    // Запускаем рендер сразу, но видео ждут клика
    if(document.fonts && document.fonts.ready) document.fonts.ready.then(start); else start();
    setTimeout(start, 2500);
    // Lock scroll only while the cinematic loader is up.
    // Landing / multipage / chooser modes skip the loader entirely
    // and need free scrolling from the first paint.
    {
      const rootCls = document.documentElement.classList;
      const needsLoader = !rootCls.contains('mode-landing')
                       && !rootCls.contains('mode-multipage')
                       && !rootCls.contains('show-chooser');
      if (needsLoader) {
        document.documentElement.style.overflow = 'hidden';
        document.body.style.overflow = 'hidden';
      } else {
        const ld = document.getElementById('loading');
        if (ld) ld.classList.add('gone');
      }
    }
    function enterStudio(){
      syncSceneVideos(Math.max(activeSceneVideoIndex,0));
      document.documentElement.style.overflow = '';
      document.body.style.overflow = '';
      setTimeout(()=>document.getElementById('loading').classList.add('gone'), 400);
    }
    function showEnter(){
      const btn=document.getElementById('enterBtn');
      const bar=document.getElementById('lBar');
      const st=document.getElementById('lStatus');
      if(!btn) return;
      if(bar) bar.style.display='none';
      const labels={en:'Click to enter the studio',ru:'Нажмите, чтобы войти',uz:"Studiyaga kirish uchun bosing"};
      if(st) st.textContent = labels[curLang] || labels.en;
      btn.style.display='inline-block';
    }
    document.getElementById('enterBtn').addEventListener('click', enterStudio);
    if(document.readyState==='complete') showEnter();
    else window.addEventListener('load', showEnter);
    setTimeout(showEnter, 1800);

    // Keyboard nav — Arrow Down/Up jump between stages
    const sectionEls = Array.from(document.querySelectorAll('.stage'));
    function jumpStage(dir){
      const y = window.scrollY + window.innerHeight*0.5;
      let idx = 0;
      sectionEls.forEach((el, i) => { if(el.offsetTop <= y) idx = i; });
      const target = sectionEls[Math.max(0, Math.min(sectionEls.length-1, idx + dir))];
      if(target) target.scrollIntoView({behavior:'smooth', block:'start'});
    }
    window.addEventListener('keydown', (e) => {
      if(document.activeElement && /INPUT|TEXTAREA|SELECT/.test(document.activeElement.tagName)) return;
      if(e.key === 'ArrowDown' || e.key === 'PageDown'){ e.preventDefault(); jumpStage(1); }
      else if(e.key === 'ArrowUp' || e.key === 'PageUp'){ e.preventDefault(); jumpStage(-1); }
      else if(e.key === 'Home'){ e.preventDefault(); window.scrollTo({top:0, behavior:'smooth'}); }
      else if(e.key === 'End'){ e.preventDefault(); window.scrollTo({top:document.body.scrollHeight, behavior:'smooth'}); }
    });

    /* ============================================================
       MOBILE LAYER WIRING
       Only runs when <html.is-mobile-view>.
       Auto-dismisses the desktop loader, drives snap-scroll progress,
       menu drawer, contact sheet, language sync.
       ============================================================ */
    (function(){
      if(!document.documentElement.classList.contains('is-mobile-view')) return;

      // Skip the desktop "Enter the studio" gate — auto-enter.
      try {
        document.documentElement.style.overflow = '';
        document.body.style.overflow = '';
        const ld = document.getElementById('loading');
        if(ld) ld.classList.add('gone');
      } catch(e) {}
      setTimeout(()=>{ try{ if(typeof enterStudio==='function') enterStudio(); }catch(e){} }, 100);

      const scrollEl  = document.getElementById('m-scroll');
      const sceneEls  = scrollEl ? scrollEl.querySelectorAll('.m-scene') : [];
      const fillEl    = document.getElementById('m-fill');
      const nowEl     = document.getElementById('m-now');
      const labelEl   = document.getElementById('m-label');
      const dotsHost  = document.getElementById('m-dots');
      const TITLES = ['ВХОД','ХАБ 6 НАПРАВЛЕНИЙ','COMMERCIAL VIDEOS','AI VIDEO','REELS','BRAND FILMS','VISUAL POLISH','AI SITES','AUTOMATIONS','SYSTEMS','ФИНАЛЬНАЯ ЗОНА','LAUNCH'];

      if(!scrollEl || !sceneEls.length) return;

      // build side progress dots
      sceneEls.forEach((_, i) => {
        const d = document.createElement('i');
        d.dataset.i = i;
        dotsHost.appendChild(d);
      });
      const dots = dotsHost.querySelectorAll('i');

      let activeIdx = -1;
      function setActive(i){
        if(i === activeIdx) return;
        activeIdx = i;
        sceneEls.forEach((s, j) => s.classList.toggle('active', j === i));
        dots.forEach((d, j) => d.classList.toggle('active', j === i));
        if(nowEl)   nowEl.textContent   = String(i).padStart(2, '0');
        if(labelEl) labelEl.textContent = TITLES[i] || '';
        if(fillEl)  fillEl.style.width  = ((i / Math.max(1, sceneEls.length - 1)) * 100) + '%';
      }
      setActive(0);

      // Intersection-observer-based active scene detection inside scroll container.
      const io = new IntersectionObserver(entries => {
        let bestRatio = 0, best = null;
        entries.forEach(e => {
          if(e.intersectionRatio > bestRatio){ bestRatio = e.intersectionRatio; best = e.target; }
        });
        if(best) setActive(parseInt(best.dataset.stage, 10));
      }, { root: scrollEl, threshold: [0.25, 0.5, 0.75, 0.9] });
      sceneEls.forEach(s => io.observe(s));

      // Public navigation API used by header/menu buttons
      window.mGo = function(i){
        const target = sceneEls[i];
        if(!target) return;
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        document.documentElement.classList.remove('menu-open');
      };
      window.mToggleMenu = function(){
        document.documentElement.classList.toggle('menu-open');
      };
      window.mOpenSheet = function(closeMenu){
        if(closeMenu) document.documentElement.classList.remove('menu-open');
        document.documentElement.classList.add('sheet-open');
      };
      window.mCloseSheet = function(){
        document.documentElement.classList.remove('sheet-open');
      };

      // Language buttons inside the mobile menu reuse the desktop applyLang().
      document.querySelectorAll('[data-mlang]').forEach(btn => {
        btn.addEventListener('click', () => {
          const L = btn.getAttribute('data-mlang');
          try { if(typeof applyLang === 'function') applyLang(L); } catch(e) {}
          document.querySelectorAll('[data-mlang]').forEach(o => o.classList.toggle('active', o === btn));
        });
      });

      // Mobile contact form — POSTs to the same Apps Script backend.
      const mForm = document.getElementById('m-contact-form');
      if(mForm){
        mForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          const st = mForm.querySelector('.m-form-status');
          const d  = new FormData(mForm);
          const n  = (d.get('name')    || '').trim();
          const p  = (d.get('phone')   || '').trim();
          const pr = (d.get('project') || '').trim();
          const T  = (typeof i18n !== 'undefined' && i18n[curLang]) ? i18n[curLang] : {};
          if(!n || !p){
            if(st){ st.textContent = T.formError || 'Заполните имя и контакт.'; st.style.color = '#ff8c8c'; }
            return;
          }
          if(st){ st.textContent = '…'; st.style.color = '#9aa8ba'; }
          const result = await submitLead({
            name: n, phone: p, project: pr,
            lang: curLang, mode: currentMode(), source: 'site-mobile'
          });
          if(result && result.ok){
            if(st){ st.textContent = T.formSuccess || 'Спасибо — ответим в течение 24 часов.'; st.style.color = '#6ee7ff'; }
            mForm.reset();
          } else {
            if(st){ st.textContent = T.formError || 'Не удалось отправить — попробуйте ещё раз.'; st.style.color = '#ff8c8c'; }
          }
        });
      }

      // ESC closes any open overlay (useful for desktop devtools mobile preview).
      document.addEventListener('keydown', e => {
        if(e.key === 'Escape'){
          document.documentElement.classList.remove('menu-open');
          document.documentElement.classList.remove('sheet-open');
        }
      });

      // Make sure first scene is active after the snap layout settles.
      requestAnimationFrame(() => setActive(0));

      /* Photo backgrounds — preload all 10 unique corridor images.
         If at least the first one loads successfully, switch to "photos-loaded"
         mode (which hides the CSS schematic). If it fails (file missing),
         the CSS gradient corridors stay as graceful fallback. */
      const CORRIDOR_FILES = [
        'corridor-01-entrance.jpg', 'corridor-02-nav-hub.jpg',
        'corridor-03-commercial.jpg', 'corridor-04-ai-video.jpg',
        'corridor-05-brand-films.jpg', 'corridor-06-visual-polish.jpg',
        'corridor-07-ai-sites.jpg', 'corridor-08-automations.jpg',
        'corridor-09-systems.jpg', 'corridor-10-final-zone.jpg'
      ];
      let firstResolved = false;
      CORRIDOR_FILES.forEach((file, idx) => {
        const img = new Image();
        img.onload = () => {
          if(!firstResolved){
            firstResolved = true;
            document.documentElement.classList.add('photos-loaded');
          }
        };
        img.onerror = () => { /* missing file — schematic fallback stays */ };
        img.src = 'assets/corridors/' + file;
      });
    })();
  </script>
</body>
</html>
