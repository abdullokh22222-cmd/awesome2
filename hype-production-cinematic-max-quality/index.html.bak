        <li><button type="button" onclick="window.mGo&&window.mGo(0)">Фон</button></li>
        <li><button type="button" onclick="window.mGo&&window.mGo(10)">О нас</button></li>
        <li><button type="button" onclick="window.mOpenSheet&&window.mOpenSheet(true)">Контакты</button></li>
